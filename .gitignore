# =============================================================================
# FSx for ONTAP Lakehouse Integrations - .gitignore
# =============================================================================
# Design Policy:
#   - INCLUDE: CloudFormation templates, Terraform configs, scripts, docs, notebooks
#   - EXCLUDE: .kiro (IDE-specific), secrets, environment-specific configs,
#              build artifacts, test results with screenshots
# =============================================================================

# =============================================================================
# Blog drafts and feedback (contain reviewer PII, unpublished content)
# Published versions go to dev.to directly, not to this repo.
# =============================================================================
blog/

# =============================================================================
# Playwright MCP (browser automation snapshots with sensitive data)
# =============================================================================
.playwright-mcp/

# =============================================================================
# Kiro IDE Configuration (development-specific, not for public repo)
# =============================================================================
.kiro/

# =============================================================================
# Private directories (account details, screenshots with PII, credentials refs)
# These contain environment-specific information not suitable for public repo.
# To publish content, move to docs/ with sensitive values redacted.
# =============================================================================
**/.private/

# =============================================================================
# Environment-Specific Files (contain AWS Account IDs, endpoints, etc.)
# =============================================================================
*.env
.env.*
.env.local
.env.*.local
env.yaml
env.yml

# Terraform variable files with actual values
*.auto.tfvars
terraform.tfvars
!example.tfvars
!terraform.tfvars.example

# CloudFormation parameter files with actual values
*-params.json
*-parameters.json
**/params.json
**/params-*.json
!*-params.example.json
!**/params.example.json
!**/params-*.example.json

# Local state written by setup scripts so a later phase needs fewer arguments.
# No secrets, but environment-specific.
**/.external-volume-state

# AWS credentials and config
.aws/
credentials.json
aws-exports.js

# =============================================================================
# Secrets and Keys
# =============================================================================
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*secret*
*credential*
!**/docs/**/*credential*
!**/snowflake/**/*credential*
!**/opensharing-server/**/*credential*
# "Storage credential" is the Unity Catalog object name, so an infrastructure
# template and an example parameter file legitimately carry the word. Both hold
# placeholders only. Narrow exceptions rather than weakening *credential*:
# a file that silently fails to commit is worse than one that is blocked loudly.
!integrations/databricks/uc-storage-credential-role.yaml
!cfn-params/*credential*.example.json
!**/docs/**/*secret*

# =============================================================================
# Node.js
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.python-version

# =============================================================================
# Terraform
# =============================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl
crash.log
crash.*.log

# =============================================================================
# IDE and Editor
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================================================
# Test Results and Screenshots (generated during verification)
# =============================================================================
**/tests/results/
**/tests/screenshots/
**/tests/.cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
junit-*.xml

# =============================================================================
# Build Artifacts
# =============================================================================
*.js.map
dist/
out/
*.zip
*.tar.gz

# =============================================================================
# Temporary Files (generated by scripts)
# =============================================================================
.tmp/
**/_cleanup_generated.sql

# =============================================================================
# Logs
# =============================================================================
*.log
logs/

# =============================================================================
# Asciinema recordings (may contain account IDs, resource ARNs in terminal output)
# =============================================================================
*.cast

# =============================================================================
# OS-specific
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
.private-evidence-record.yaml
integrations/iceberg-metadata-catalog/snowflake/screenshots/raw/

# Validation parameter files (contain real credentials)
**/params.env
**/.cross-region-state.env
**/.s3ap_alias
**/.vol_id

# Unpublished drafts and review provenance. This used to be covered only by the global gitignore
# (~/.config/git/ignore), which was narrowed on 2026-09-19 so that an agent could read .private/ in
# a different repository. Stating it here means this repository no longer depends on that file.
.private/
