#!/bin/bash
# Pre-commit hook: author email check + gitleaks secret scanning
# Setup: git config core.hooksPath .githooks

set -euo pipefail

# === 1. Author email check ===
ALLOWED_EMAIL="40357845+Yoshiki0705@users.noreply.github.com"
CURRENT_EMAIL=$(git config user.email)

if [ "$CURRENT_EMAIL" != "$ALLOWED_EMAIL" ]; then
  echo "❌ ERROR: Git user.email is '$CURRENT_EMAIL'"
  echo "   Expected: '$ALLOWED_EMAIL'"
  echo ""
  echo "   Fix with: git config user.email '$ALLOWED_EMAIL'"
  exit 1
fi

# === 2. gitleaks secret scanning ===
if command -v gitleaks &> /dev/null; then
  echo "🔍 gitleaks: シークレットスキャン実行中..."
  if ! gitleaks protect --staged --config .gitleaks.toml --verbose 2>/dev/null; then
    echo ""
    echo "❌ ERROR: gitleaks がシークレットを検出しました"
    echo "   詳細: gitleaks protect --staged --config .gitleaks.toml --verbose"
    echo "   除外: .gitleaks.toml の allowlist を更新してください"
    exit 1
  fi
  echo "✅ gitleaks: シークレット未検出"
elif command -v pre-commit &> /dev/null; then
  # pre-commit がインストールされている場合はそちらに委譲
  echo "🔍 pre-commit 経由でチェック実行中..."
  pre-commit run gitleaks --hook-stage commit 2>/dev/null || {
    echo "⚠️  pre-commit gitleaks hook failed"
    exit 1
  }
else
  echo "⚠️  gitleaks が未インストールです"
  echo "   Install: brew install gitleaks"
  echo "   Or: pip install pre-commit && pre-commit install"
  # 警告のみ（CI で捕捉するため）
fi

# === 3. zizmor check (GitHub Actions files only) ===
STAGED_WORKFLOWS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.github/(workflows|actions)/' || true)

if [ -n "$STAGED_WORKFLOWS" ] && command -v zizmor &> /dev/null; then
  echo "🔍 zizmor: GitHub Actions セキュリティリント実行中..."
  if ! echo "$STAGED_WORKFLOWS" | xargs zizmor 2>/dev/null; then
    echo ""
    echo "⚠️  zizmor: セキュリティ警告が検出されました"
    echo "   詳細を確認してください（コミットはブロックしません）"
  else
    echo "✅ zizmor: 問題なし"
  fi
fi

# === 4. Tenant identifiers that gitleaks does not catch ===
# gitleaks looks for credential-shaped strings. A Databricks workspace hostname or a bare
# account UUID is not credential-shaped, so it passes gitleaks while still identifying a
# live tenant in a public repository. This was found the hard way on 2026-08-12: values
# committed in May-June 2026 required a full history rewrite plus a host-side purge,
# because editing the file does not remove what is already in history.
STAGED_TEXT=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -vE '^\.private/|^\.githooks/' || true)
if [ -n "$STAGED_TEXT" ]; then
  echo "🔍 tenant identifier scan..."
  # Databricks workspace hostname (dbc-xxxxxxxx-xxxx.cloud.databricks.com).
  # Placeholders such as dbc-xxx / <WORKSPACE_ID> are allowed.
  DBX_HITS=$(echo "$STAGED_TEXT" | xargs grep -nIE 'dbc-[0-9a-f]{8}-[0-9a-f]{4}\.cloud\.databricks\.com' 2>/dev/null || true)
  # Databricks workspace org id in a URL (?o=<16 digits>)
  ORG_HITS=$(echo "$STAGED_TEXT" | xargs grep -nIE '[?&]o=[0-9]{16}' 2>/dev/null || true)
  if [ -n "$DBX_HITS" ] || [ -n "$ORG_HITS" ]; then
    echo ""
    echo "❌ ERROR: a live tenant identifier is staged"
    [ -n "$DBX_HITS" ] && echo "$DBX_HITS" | sed 's/^/   /'
    [ -n "$ORG_HITS" ] && echo "$ORG_HITS" | sed 's/^/   /'
    echo ""
    echo "   Replace with a placeholder: <WORKSPACE_ID>, <WORKSPACE_ORG_ID>"
    echo "   These are not secrets, but they identify a live tenant in a public repo,"
    echo "   and removing them after the fact needs a history rewrite + a GitHub purge."
    exit 1
  fi
  echo "✅ tenant identifier scan: clean"
fi

# === 5. Credentials left in browser-automation snapshots ===
# Snapshot directories are gitignored, so nothing here can reach the repository. The check
# runs anyway because a commit is a natural point to notice a local leak: a browser
# password manager autofills a sign-in form, the value lands in the accessibility tree,
# and the tree is written to disk. Masking removes the file copy; only rotation fixes the
# credential, which is why this warns loudly instead of staying silent.
# Warn-only: this is not about what is being committed.
REDACTOR=shared/scripts/redact_browser_snapshots.py
if [ -f "$REDACTOR" ] && command -v python3 &> /dev/null; then
  # Selftest first. This check ran clean for months while three of its five patterns
  # could not match a credential with Japanese text beside it: Python's \b treats CJK
  # as a word character, so アクセストークンdapi… has no boundary before "dapi".
  # A clean --check was therefore not evidence of a clean machine.
  if ! python3 "$REDACTOR" --selftest >/dev/null; then
    echo "❌ ERROR: redact_browser_snapshots.py の selftest が落ちました（検出器自体の不具合）"
    exit 1
  fi
  if ! python3 "$REDACTOR" --check >/tmp/.snapshot-audit 2>&1; then
    echo ""
    echo "⚠️  a credential is sitting unredacted in a browser snapshot on this machine"
    sed 's/^/   /' /tmp/.snapshot-audit
    echo ""
    echo "   Mask it:   python3 $REDACTOR"
    echo "   Then ROTATE the credential — masking the file does not undo the exposure."
    echo "   (Not blocking this commit: snapshot directories are gitignored.)"
  fi
  rm -f /tmp/.snapshot-audit
fi

# === 6. Japanese section headings must be noun phrases (体言止め) ===
# The selftest runs first, on purpose. A checker that cannot fail is indistinguishable
# from no checker at all, and a green gate is not evidence that the gate ran.
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
if [ -n "$STAGED_MD" ] && command -v python3 &> /dev/null; then
  echo "🔍 heading style: 日本語の節見出しが体言止めか検査中..."
  if ! python3 scripts/check-heading-style.py --selftest >/dev/null; then
    echo "❌ ERROR: check-heading-style.py の selftest が落ちました（検査器自体の不具合）"
    exit 1
  fi
  if ! python3 scripts/check-heading-style.py; then
    echo ""
    echo "❌ ERROR: 体言止めでない日本語の節見出しがあります"
    echo "   接尾語（〜の存在 / 〜の不成立 / 〜の理由 等）で断定を保って名詞化してください"
    echo "   叙述・助言・抱負として意図した見出しは <!-- allow:heading-style --> を付与"
    exit 1
  fi
fi

# === 7. The detectors' selftests must be able to tell broken from working ===
# Narrowing a match and widening it are different failures -- positive cases catch the
# first, only negative cases catch the second.
#
# Runs unconditionally. An earlier version ran only when a detector was staged, which
# introduced a distinction this hook had no way to express: "did not run" and "passed"
# both printed nothing. Measured cost is 0.26s, so the branch bought nothing and cost
# the ability to read a clean run. (It is this cheap only because all three selftests
# are pure functions over in-source case tables -- no fixtures, no network, no ROOT. A
# selftest that needed any of those would change this calculation.)
if command -v python3 &> /dev/null; then
  echo "🔍 mutation: 検出器の selftest が壊れ方を識別できるか検査中..."
  if ! python3 scripts/check-detector-mutations.py; then
    echo ""
    echo "❌ ERROR: 変異が生き残った、または変異が対象テキストを見つけられませんでした"
    echo "   生き残り = その guard はどのテストケースにも守られていません"
    echo "   一致範囲が広がる壊し方は、否定ケース（正当な文字列の部分文字列）だけが止めます"
    exit 1
  fi
fi

# === 8. EN/JA docs must agree on unit-bearing quantities ===
# The JA/EN parity check in CI counts sections. Section counts matched while the same
# table said "PutObject 5 GB ceiling" in EN and "50 GB 上限" in JA, so nothing complained.
# The cause was not a translation error: two different ceilings (per-part and
# whole-object) were being presented as one, and the language mismatch is what exposed
# the structural error. Selftest first, same reason as step 6.
if [ -n "$STAGED_MD" ] && command -v python3 &> /dev/null; then
  echo "🔍 number parity: EN/JA の単位付き数量が一致するか検査中..."
  if ! python3 scripts/check-doc-number-parity.py --selftest >/dev/null; then
    echo "❌ ERROR: check-doc-number-parity.py の selftest が落ちました（検査器自体の不具合）"
    exit 1
  fi
  if ! python3 scripts/check-doc-number-parity.py; then
    echo ""
    echo "❌ ERROR: EN/JA 対の間で単位付きの数量が食い違っています"
    echo "   片方が古い / 単位が違う / 別々の数量を 1 つにまとめている のいずれかです"
    echo "   片方の言語にしか無い数量なら <!-- allow:number-parity --> を付与"
    exit 1
  fi
fi

echo "✅ pre-commit checks passed"
